# Placeholders only. Never commit real values. Reference: docs/environment.md
# Each variable: [required|optional] [secret|config]. "production" = required when NODE_ENV=production.

# ---- Core ----
# optional config
NODE_ENV=development
# production-required config: public https URL of the ACTIVE production domain
APP_URL=http://localhost:3000
# LEGACY, unused by this Express app (no separate backend host). Leave blank. Kept only so the env validator and docs stay consistent.
SITE_API_URL=
# optional config: extra CORS origins (Express)
ALLOWED_ORIGINS=
# optional config: Express only
PORT=3000
# optional secret (24+ chars): unlocks detailed /api/health/supabase
HEALTH_DIAGNOSTICS_TOKEN=
# Set true to enable the authenticated external scheduler endpoint
SCHEDULER_ENABLED=false

# ---- Google sign-in (optional; see docs/google-signin.md) ----
# Set to true ONLY after enabling the Google provider in Supabase and adding the redirect URL.
GOOGLE_AUTH_ENABLED=false

# ---- Supabase (server only) ----
# production-required config
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# production-required secret-class key
SUPABASE_ANON_KEY=
# production-required SECRET: bypasses RLS, server only
SUPABASE_SERVICE_ROLE_KEY=
# optional secret
SUPABASE_AUTH_HOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Eliah Tech <no-reply@yourdomain.com>
EMAIL_TIMEOUT_MS=8000
# Search engine ownership verification (optional). Paste ONLY the token from the HTML tag method: the value of content="..."
# in <meta name="google-site-verification" content="TOKEN"> (Google Search Console) or <meta name="msvalidate.01" content="TOKEN"> (Bing Webmaster Tools).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Newsletters are sent manually from Admin > Newsletter, at most this many emails per UTC day (free Resend plan: 100/day shared with
# sign-up, payment and contact emails, so 30 is a safe default). The admin setting "Daily sending limit" overrides this value.
NEWSLETTER_DAILY_LIMIT=30
# Emails claimed per database request (1-50). Leave as is.
NEWSLETTER_BATCH_SIZE=50

# ---- Payments: PesaPal (set key+secret together) ----
# must be "live" in production
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=
PESAPAL_CANCELLATION_URL=
PESAPAL_BASE_URL=
PESAPAL_CURRENCY=

# ---- Payments: PayPal (set id+secret together) ----
# must be https://api-m.paypal.com in production
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYMENT_TIMEOUT_MS=

# ---- Tooling ----
JODIT_VERSION=
# legacy alias of ALLOWED_ORIGINS
CORS_ORIGIN=

# ---- AI platform (free providers) ----
GROQ_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_MODEL=
AI_DEFAULT_CAPABILITY=general
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=20000
AI_ALLOWED_BASE_HOSTS=

# Posts-only ads: operator-approved exact HTTPS origins. Blank disables ad execution.
AD_ALLOWED_ORIGINS=
# Optional voice transcription through the Groq free plan.
AI_VOICE_ENABLED=false
OPENROUTER_API_KEY=

# Required ONLY if SCHEDULER_ENABLED=true (daily newsletter sending, game notifications, link checks).
# Set JOBS_TOKEN for an external scheduler (POST /api/v1/jobs/run with `Authorization: Bearer <JOBS_TOKEN>`),
# or CRON_SECRET for Vercel Cron (it sends `Authorization: Bearer <CRON_SECRET>` with a GET automatically).
# Use a random 32+ character secret, e.g. `openssl rand -hex 32`. Calling the endpoint more often is harmless:
# newsletters never exceed the daily limit. If SCHEDULER_ENABLED=true and both are blank, the endpoint returns 403.
JOBS_TOKEN=
CRON_SECRET=
